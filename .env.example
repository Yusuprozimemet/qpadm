# Copy to .env and adjust to your machine.

# Directory containing the compiled AdmixTools binaries
# (qpAdm, qpfstats, convertf, mergeit) and the plink executable.
# Leave blank to rely on the system PATH.
ADMIXTOOLS_BIN=

# Path to the plink 1.9 executable. If blank, "plink" on PATH is used.
PLINK_BIN=

# Directory holding the AADR reference panel in EIGENSTRAT format.
# It must contain the trio <REFERENCE_PREFIX>.geno/.snp/.ind
REFERENCE_DIR=

# File-name prefix of the reference panel inside REFERENCE_DIR.
REFERENCE_PREFIX=v54.1.p1_1240K_public

# Where uploads, intermediate files and results are written.
WORK_DIR=./workdir
